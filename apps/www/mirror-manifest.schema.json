{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirror-manifest.schema.json",
  "title": "jixoai-ui mirror manifest",
  "description": "Machine-readable source of truth for registry/files ↔ apps/www/src/lib. Generated by scripts/gen-mirror-manifest.mjs (check mode = drift detector). canonicalMain: exactly one entry per registry:ui item (the manifest generator enforces the cross-document uniqueness; toast is the explicit non-identical override).",
  "type": "object",
  "required": ["$schema", "version", "generatedAt", "canonicalMain", "items", "siteOnly", "registryOnly", "unreferencedLib"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "canonicalMain": {
      "type": "object",
      "description": "itemName → canonical main source path. Keys are unique by construction; exactly one per registry:ui item.",
      "additionalProperties": { "type": "string", "pattern": "^registry/files/ui/.+\\.svelte$" }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itemName", "type", "files"],
        "properties": {
          "itemName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "enum": ["registry:ui", "registry:lib", "registry:theme", "registry:file"] },
          "canonicalMain": { "type": "string", "pattern": "^registry/files/ui/.+\\.svelte$" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "mirror", "target", "sourceSha", "mirrorSha"],
              "properties": {
                "source": { "type": "string", "pattern": "^registry/files/" },
                "mirror": { "type": "string", "pattern": "^apps/www/src/lib/" },
                "target": { "type": "string", "pattern": "^@(ui|lib)/" },
                "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "mirrorSha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "registry:ui" } } },
            "then": { "required": ["canonicalMain"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "siteOnly": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "registryOnly": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "unreferencedLib": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "required": ["path", "note"],
      "properties": {
        "path": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
