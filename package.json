{
  "name": "jixoai-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-site.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "dev:studio": "node scripts/build-studio.mjs --watch",
    "build:registry": "shadcn build && node scripts/gen-stylex-payload.mjs --publish public",
    "build:blueprints": "node scripts/build-blueprints.mjs",
    "shots": "node scripts/capture-baseline.mjs",
    "gen:icons": "node scripts/gen-icon-set.mjs",
    "gen:spins": "node scripts/gen-spin-set.mjs",
    "gen:migration": "node scripts/verify-icon-migration.mjs --write",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:mirror": "node scripts/gen-mirror-manifest.mjs --check",
    "verify:tailwindless": "node scripts/verify-tailwindless.mjs --check",
    "verify:docs": "node scripts/verify-docs-structure.mjs",
    "verify:meta": "node scripts/component-metadata-gen.mjs --check",
    "verify:print": "node scripts/verify-print.mjs",
    "verify:press": "node scripts/verify-press.mjs",
    "verify:surface": "node scripts/verify-surface.mjs",
    "verify:km": "node scripts/verify-katex-mermaid.mjs",
    "verify:popover-area": "node scripts/verify-popover-area-align.mjs",
    "verify:trygrid": "node scripts/verify-trygrid.mjs",
    "verify:parity": "node scripts/verify-native-parity.mjs",
    "verify:budgets": "node scripts/verify-budgets.mjs",
    "verify:laws": "cd packages/css-laws && node_modules/.bin/tsx src/build.ts --check",
    "verify:standards": "node scripts/verify-standards.mjs",
    "verify:deps": "node scripts/verify-deps.mjs",
    "verify:cli": "node scripts/verify-jixoai-cli.mjs",
    "verify:icons": "node scripts/gen-icon-set.mjs --check",
    "verify:spins": "node scripts/gen-spin-set.mjs --check",
    "verify:migration": "node scripts/verify-icon-migration.mjs --check",
    "verify:stylex-authoring": "node scripts/verify-stylex-authoring.mjs",
    "verify:stylex-payload": "node scripts/verify-stylex-payload.mjs",
    "gen:universal-props": "node scripts/gen-universal-props-css.mjs",
    "verify:universal-props": "node scripts/gen-universal-props-css.mjs --check",
    "gen:stylex-payload": "node scripts/gen-stylex-payload.mjs",
    "verify:shadcn-add": "node scripts/verify-shadcn-add.mjs",
    "verify:ghostty-pin": "node scripts/verify-ghostty-pin.mjs",
    "verify:betlang-pin": "node scripts/verify-betlang-pin.mjs",
    "test:types": "npm --prefix apps/www run test:types",
    "verify:context": "node scripts/verify-context-coverage.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "cli-spinners": "^2.9.2",
    "lucide": "^0.472.0",
    "playwright-core": "^1.62.1",
    "satori": "^0.33.3",
    "shadcn": "^4.18.0"
  }
}
