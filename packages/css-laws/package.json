{
  "name": "@jixoai/css-laws",
  "version": "0.1.0",
  "description": "Type-safe CSS law definitions — single source, dual output (utility class + element-default)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./laws/*": {
      "import": "./src/laws/*.ts",
      "types": "./src/laws/*.ts"
    }
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "build:watch": "tsx watch src/build.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.0.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "private": true
}
