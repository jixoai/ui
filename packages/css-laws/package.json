{
  "name": "@jixoai/css-laws",
  "version": "0.1.0",
  "description": "Bounded serializer for the 13 native form-control laws — one TS declaration source, three CSS projections (utility class, bare-element face, Tier-2 alias)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./laws/*": {
      "import": "./src/laws/*.ts",
      "types": "./src/laws/*.ts"
    }
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "build:watch": "tsx watch src/build.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.0.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "private": true
}
