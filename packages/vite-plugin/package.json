{
  "name": "@jixoai/ui-vite-plugin",
  "version": "0.4.0",
  "description": "Vite plugin supplying the pinned ghostty-vt wasm: resolve (env -> cache -> verified download) -> serve (dev middleware) -> emit (content-addressed asset) -> hand over the URL via the virtual:jixoai-ghostty module. Also ships the icon system (svg/lucide/font providers + serializer + safety) behind the ./icons subpath and the jixoai() icons feature option, the canvas same-source extractor + standalone canvasPlugin() behind the ./canvas subpath, and the svg-spinner set generator (vendored blocks-wave + custom sources -> spin-set.gen.ts, behind the ./spinners subpath and the jixoai() spinners feature option) plus the two injectable loader packs (the 94 verified-working magecdn loaders — pixel-swept through the component path — and the 12-loader SamHerbert SVG-Loaders set as ./spinners/[magecdn|svg-loaders] sub-entries). Ships the jixoai-ghostty-probe ABI sentinel bin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jixoai-ghostty-probe": "./dist/probe.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/channel": {
      "types": "./dist/icons/channel.d.ts",
      "import": "./dist/icons/channel.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons/lucide.d.ts",
      "import": "./dist/icons/lucide.js"
    },
    "./icons/md": {
      "types": "./dist/icons/md.d.ts",
      "import": "./dist/icons/md.js"
    },
    "./icons/ph": {
      "types": "./dist/icons/ph.d.ts",
      "import": "./dist/icons/ph.js"
    },
    "./icons/rx": {
      "types": "./dist/icons/rx.d.ts",
      "import": "./dist/icons/rx.js"
    },
    "./spinners": {
      "types": "./dist/spinners.d.ts",
      "import": "./dist/spinners.js"
    },
    "./spinners/magecdn": {
      "types": "./dist/spinners/magecdn.d.ts",
      "import": "./dist/spinners/magecdn.js"
    },
    "./spinners/svg-loaders": {
      "types": "./dist/spinners/svg-loaders.d.ts",
      "import": "./dist/spinners/svg-loaders.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ghostty.pin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "svgo": "^4.1.0"
  },
  "peerDependencies": {
    "@material-symbols/svg-100": "^0.47.0",
    "@material-symbols/svg-200": "^0.47.0",
    "@material-symbols/svg-300": "^0.47.0",
    "@material-symbols/svg-400": "^0.47.0",
    "@material-symbols/svg-500": "^0.47.0",
    "@material-symbols/svg-600": "^0.47.0",
    "@material-symbols/svg-700": "^0.47.0",
    "@phosphor-icons/core": "^2.1.1",
    "lucide": "^0.472.0",
    "remixicon": "^4.6.0",
    "svelte": "^5.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@material-symbols/svg-100": {
      "optional": true
    },
    "@material-symbols/svg-200": {
      "optional": true
    },
    "@material-symbols/svg-300": {
      "optional": true
    },
    "@material-symbols/svg-400": {
      "optional": true
    },
    "@material-symbols/svg-500": {
      "optional": true
    },
    "@material-symbols/svg-600": {
      "optional": true
    },
    "@material-symbols/svg-700": {
      "optional": true
    },
    "@phosphor-icons/core": {
