{
  "name": "@jixoai/ui-design",
  "version": "0.1.0",
  "description": "The design-studio server: one vite dev server serving the studio shell, frame surface and prototype canvases over a host workspace (design/), plus the DesignAgent seam, knowledge pack and scaffold. Source-distributed (css-laws precedent) — consumed live by vite, no dist build.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./studio": {
      "types": "./src/studio/mount.ts",
      "import": "./src/studio/mount.ts"
    },
    "./agent": {
      "types": "./src/agent/types.ts",
      "import": "./src/agent/types.ts"
    },
    "./knowledge": {
      "types": "./src/knowledge/knowledge.ts",
      "import": "./src/knowledge/knowledge.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "knowledge:snapshot": "node src/knowledge/build.ts"
  },
  "devDependencies": {
    "@jixoai/ui-vite-plugin": "file:../../packages/vite-plugin",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.2.1",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0"
  }
}
